# ============================================================
# Tauri / Rust 构建产物（2026-09/15 补：建库前必须先补，否则 git add . 会
# 把 target 约 47GB、gen/android build 约 10.8GB 一次性入仓）
# ============================================================
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/.idea/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/buildSrc/build/
# 打包前由 打包.ps1 自动生成（minmax 全量压缩，37MB），随构建再生，不入仓
/src-tauri/runtime.zip

# ============================================================
# ⚠️ 凭据 / 隐私：以下内容绝不能入仓（一旦推送即泄露真实账号会话与运行时分发物）
# ============================================================
# 模拟浏览器登录的登录态（真实账号会话 cookie，Playwright storageState）
minmax/web_state/
# 随包的 Node 运行时（88MB 二进制，随 minmax/ 目录分发，不入仓）
minmax/node.exe

# 开发期量测采样与捕获截图（probe/ 的代码与说明入仓，量测产物不入仓）
# ⚠️ 必须写成 `dir/*` + 否定例外，不能只写 `dir/`：目录整体被排除后 git 不再进入该目录，
#    里面的 `!` 例外规则就不会生效（本条踩过一次：`/probe/traces/` + `!/probe/traces/README.md` 无效）。
/probe/traces/*
!/probe/traces/README.md
/probe/shots/
