# —— 编辑器 / 系统 ——
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# —— 依赖与前端构建产物 ——
node_modules
dist
dist-ssr
*.local

# —— 日志 ——
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Tauri / Rust 构建产物
# ⚠️ 建库前必须先补这些规则，否则 `git add .` 会把
#    src-tauri/target（约 47GB）与 gen/android build（约 10.8GB）一次性入仓
# ============================================================
/src-tauri/target/
/src-tauri/gen/schemas/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/.idea/
/src-tauri/gen/android/local.properties
/src-tauri/gen/android/buildSrc/build/

# ============================================================
# ⚠️ 用户配置与敏感信息（含真实 API Key / AccessKey Secret，切勿提交）
# ============================================================
# 应用运行时的配置在 %APPDATA%\com.apibalance.monitor[.dev]\config.json，
# 正常不会出现在项目目录；这里兜底拦住手工复制进来的副本
/config.json
/config.json.bak
/config.json.tmp
# 「模拟浏览器登录」的登录态（真实账号会话 cookie，Playwright storageState）
minmax/web_state/

# ============================================================
# 归档 / 分发包
# ⚠️ 归档入仓前**必须**先列内容确认没有登录态（`7z l <包>`）——
#    本项目踩过一次：旧的手工分发包 minmax.7z 里带着 web_state/ 登录态，
#    推送到托管平台前才发现，只能重建仓库清历史
# ============================================================
/src-tauri/runtime.zip
/minmax*.7z
/minmax*.zip
# 随包的 Node 运行时（约 88MB 二进制，随 minmax/ 目录分发，不入仓）
minmax/node.exe

# ============================================================
# 开发期量测产物（probe/ 的代码与说明入仓，采样与截图不入仓）
# ⚠️ 必须写成 `dir/*` + 否定例外，不能只写 `dir/`：目录整体被排除后 git 不再进入该目录，
#    里面的 `!` 例外规则就不会生效（本条踩过一次：`/probe/traces/` + `!/probe/traces/README.md` 无效）
# ============================================================
/probe/traces/*
!/probe/traces/README.md
/probe/shots/
